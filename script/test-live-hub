#!/bin/sh
set -eu

resolve_binary() {
  variable_name="$1"
  command_name="$2"
  eval "configured=\${$variable_name:-}"
  if [ -n "$configured" ]; then
    if [ ! -x "$configured" ]; then
      echo "$variable_name is not executable: $configured" >&2
      exit 1
    fi
    printf '%s\n' "$configured"
    return
  fi

  resolved="$(command -v "$command_name" || true)"
  if [ -z "$resolved" ]; then
    echo "set $variable_name to an explicit $command_name binary, or add $command_name to PATH" >&2
    exit 1
  fi
  printf '%s\n' "$resolved"
}

resolve_contract_matrix_fixture() {
  configured="${BOTSTER_PLUGIN_CONTRACT_MATRIX_FIXTURE:-}"
  if [ -z "$configured" ]; then
    echo "BOTSTER_PLUGIN_CONTRACT_MATRIX_FIXTURE is required for live plugin-surface proof" >&2
    exit 1
  fi
  if [ ! -d "$configured" ]; then
    echo "BOTSTER_PLUGIN_CONTRACT_MATRIX_FIXTURE is not a directory: $configured" >&2
    exit 1
  fi
  if [ ! -f "$configured/botster-package.json" ] || [ ! -f "$configured/plugin.lua" ]; then
    echo "BOTSTER_PLUGIN_CONTRACT_MATRIX_FIXTURE must contain botster-package.json and plugin.lua: $configured" >&2
    exit 1
  fi
  printf '%s\n' "$configured"
}

resolve_workspaces_package() {
  configured="${BOTSTER_WORKSPACES_PACKAGE_PATH:-}"
  if [ -z "$configured" ]; then
    echo "BOTSTER_WORKSPACES_PACKAGE_PATH is required for the Workspaces live acceptance mode" >&2
    exit 1
  fi
  if [ ! -d "$configured" ]; then
    echo "BOTSTER_WORKSPACES_PACKAGE_PATH is not a directory: $configured" >&2
    exit 1
  fi
  if [ ! -f "$configured/botster-package.json" ] || [ ! -f "$configured/plugin.lua" ]; then
    echo "BOTSTER_WORKSPACES_PACKAGE_PATH must contain botster-package.json and plugin.lua: $configured" >&2
    exit 1
  fi
  printf '%s\n' "$configured"
}

mode="${1:-contract-matrix}"
profile="${2:-}"
case "$mode" in
  contract-matrix)
    if [ "$#" -gt 1 ]; then
      echo "usage: script/test-live-hub [contract-matrix] | workspaces <plumbing|lifecycle|installed-driver|claim-driver> | session-types" >&2
      exit 1
    fi
    contract_matrix_fixture="$(resolve_contract_matrix_fixture)"
    test_filter="app::tests::headless_live_runtime_runs_against_isolated_hub_when_binaries_are_available"
    ;;
  session-types)
    if [ "$#" -gt 1 ]; then
      echo "usage: script/test-live-hub session-types" >&2
      exit 1
    fi
    test_filter="app::tests::session_types_live_profile_runs_against_isolated_hub_when_binaries_are_available"
    ;;
  workspaces)
    if [ "$#" -ne 2 ] || { [ "$profile" != "plumbing" ] && [ "$profile" != "lifecycle" ] && [ "$profile" != "installed-driver" ] && [ "$profile" != "claim-driver" ]; }; then
      echo "usage: script/test-live-hub workspaces <plumbing|lifecycle|installed-driver|claim-driver>" >&2
      exit 1
    fi
    workspaces_package="$(resolve_workspaces_package)"
    if [ "$profile" = "installed-driver" ]; then
      test_filter="app::tests::installed_workspaces_spawn_driver_runs_through_apps_open"
    elif [ "$profile" = "claim-driver" ]; then
      test_filter="app::tests::installed_workspaces_claim_driver_runs_through_apps_open"
      if [ -z "${BOTSTER_HUB_SOURCE_PATH:-}" ]; then
        echo "BOTSTER_HUB_SOURCE_PATH is required for claim-driver pin ancestry" >&2
        exit 1
      fi
      if [ ! -d "${BOTSTER_HUB_SOURCE_PATH}" ]; then
        echo "BOTSTER_HUB_SOURCE_PATH is not a directory: ${BOTSTER_HUB_SOURCE_PATH}" >&2
        exit 1
      fi
    else
      test_filter="app::tests::workspaces_live_acceptance_runs_against_real_package"
    fi
    ;;
  *)
    echo "unknown live-Hub mode: $mode" >&2
    echo "usage: script/test-live-hub [contract-matrix] | workspaces <plumbing|lifecycle|installed-driver|claim-driver> | session-types" >&2
    exit 1
    ;;
esac

if [ -n "${CARGO_TARGET_DIR:-}" ]; then
  target_dir="$CARGO_TARGET_DIR"
else
  target_dir="$(mktemp -d "${TMPDIR:-/tmp}/botster-tui-live-target.XXXXXX")"
  trap 'rm -rf "$target_dir"' EXIT
fi

claim_hub_build_target=""
claim_build_receipt=""
if [ "$profile" = "claim-driver" ]; then
  # Fresh locked Hub + session-worker builds from the recorded Hub checkout.
  # Do not reuse a stale shared target/release under the Hub source tree.
  # Canonicalize immediately so receipt commands match fs::canonicalize forms
  # (avoids TMPDIR trailing-slash // and /var vs /private/var mismatches).
  claim_hub_build_target="$(mktemp -d "${TMPDIR:-/tmp}/botster-hub-claim-build.XXXXXX")"
  claim_hub_build_target="$(cd "$claim_hub_build_target" && pwd -P)"
  trap 'rm -rf "$target_dir" "$claim_hub_build_target"' EXIT
  hub_source="$(cd "${BOTSTER_HUB_SOURCE_PATH}" && pwd -P)"
  hub_rev="$(git -C "$hub_source" rev-parse HEAD)"
  hub_build_cmd="cargo build --locked --release -p botster-hub --manifest-path ${hub_source}/Cargo.toml --target-dir ${claim_hub_build_target}"
  worker_build_cmd="cargo build --locked --release -p botster-core-daemon --bin botster-session-worker --manifest-path ${hub_source}/Cargo.toml --target-dir ${claim_hub_build_target}"
  echo "claim-driver: building Hub from ${hub_source} @ ${hub_rev}" >&2
  echo "claim-driver: ${hub_build_cmd}" >&2
  # shellcheck disable=SC2086
  cargo build --locked --release -p botster-hub --manifest-path "${hub_source}/Cargo.toml" --target-dir "${claim_hub_build_target}"
  echo "claim-driver: ${worker_build_cmd}" >&2
  # shellcheck disable=SC2086
  cargo build --locked --release -p botster-core-daemon --bin botster-session-worker --manifest-path "${hub_source}/Cargo.toml" --target-dir "${claim_hub_build_target}"
  hub_bin="${claim_hub_build_target}/release/botster-hub"
  session_worker_bin="${claim_hub_build_target}/release/botster-session-worker"
  if [ ! -x "$hub_bin" ] || [ ! -x "$session_worker_bin" ]; then
    echo "claim-driver locked Hub build did not produce executable binaries under ${claim_hub_build_target}/release" >&2
    exit 1
  fi
  # Same receipt writer as the documented parent entrypoint (exact Cargo.lock core_rev).
  export BOTSTER_HUB_BIN="$hub_bin"
  export BOTSTER_SESSION_WORKER_BIN="$session_worker_bin"
  export BOTSTER_HUB_BUILD_TARGET_DIR="$claim_hub_build_target"
  export BOTSTER_HUB_SOURCE_PATH="$hub_source"
  export BOTSTER_TUI_CLAIM_BUILD_RECEIPT="${claim_hub_build_target}/claim-build-receipt.json"
  claim_build_receipt="$(script/write-claim-build-receipt)"
  export BOTSTER_TUI_CLAIM_BUILD_RECEIPT="$claim_build_receipt"
else
  hub_bin="$(resolve_binary BOTSTER_HUB_BIN botster-hub)"
  session_worker_bin="$(resolve_binary BOTSTER_SESSION_WORKER_BIN botster-session-worker)"
fi

cargo build -p botster-tui --target-dir "$target_dir" --locked
if [ "$mode" = "contract-matrix" ] || [ "$profile" = "installed-driver" ] || [ "$profile" = "claim-driver" ]; then
  mkdir -p target/debug
  cp "$target_dir/debug/botster-tui" target/debug/botster-tui
fi

test_output="$target_dir/live-test-output"
if BOTSTER_TUI_REQUIRE_HUB_TEST=1 \
  BOTSTER_ENV=test \
  BOTSTER_HUB_BIN="$hub_bin" \
  BOTSTER_SESSION_WORKER_BIN="$session_worker_bin" \
  BOTSTER_PLUGIN_CONTRACT_MATRIX_FIXTURE="${contract_matrix_fixture:-}" \
  BOTSTER_WORKSPACES_PACKAGE_PATH="${workspaces_package:-}" \
  BOTSTER_HUB_SOURCE_PATH="${BOTSTER_HUB_SOURCE_PATH:-}" \
  BOTSTER_HUB_BUILD_TARGET_DIR="${BOTSTER_HUB_BUILD_TARGET_DIR:-}" \
  BOTSTER_TUI_CLAIM_BUILD_RECEIPT="${BOTSTER_TUI_CLAIM_BUILD_RECEIPT:-}" \
  BOTSTER_TUI_CLAIM_EVIDENCE_OUT="${BOTSTER_TUI_CLAIM_EVIDENCE_OUT:-}" \
  BOTSTER_TUI_WORKSPACES_PROFILE="$profile" \
  CARGO_TARGET_DIR="$target_dir" \
  cargo test -p botster-tui "$test_filter" -- --exact --nocapture >"$test_output" 2>&1
then
  test_status=0
else
  test_status=$?
fi
cat "$test_output"
if [ "$test_status" -ne 0 ]; then
  exit "$test_status"
fi
if ! grep -F "test $test_filter ... ok" "$test_output" >/dev/null; then
  echo "required live-Hub test did not execute exactly once: $test_filter" >&2
  exit 1
fi
if [ "$mode" = "session-types" ]; then
  if ! grep -F "session-types-live: complete" "$test_output" >/dev/null; then
    echo "session-types live profile did not complete" >&2
    exit 1
  fi
fi
if [ "$mode" = "workspaces" ]; then
  case "$profile" in
    plumbing) profile_label="Plumbing" ;;
    lifecycle) profile_label="Lifecycle" ;;
    installed-driver)
      if ! grep -F "installed-workspaces-driver: complete cases=3" "$test_output" >/dev/null; then
        echo "Workspaces installed-driver acceptance did not complete" >&2
        exit 1
      fi
      exit 0
      ;;
    claim-driver)
      if ! grep -F "installed-workspaces-claim-driver: complete" "$test_output" >/dev/null; then
        echo "Workspaces claim-driver acceptance did not complete" >&2
        exit 1
      fi
      if [ -n "${BOTSTER_TUI_CLAIM_EVIDENCE_OUT:-}" ] && [ ! -s "${BOTSTER_TUI_CLAIM_EVIDENCE_OUT}" ]; then
        echo "claim-driver evidence out path is missing or empty: ${BOTSTER_TUI_CLAIM_EVIDENCE_OUT}" >&2
        exit 1
      fi
      exit 0
      ;;
  esac
  if ! grep -F "workspaces-acceptance: profile=$profile_label ledger=complete" "$test_output" >/dev/null; then
    echo "Workspaces $profile acceptance ledger did not complete" >&2
    exit 1
  fi
fi
